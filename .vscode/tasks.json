{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "New Day",
      "type": "shell",
      "command": "bash tools/new-day.sh ${input:day}",
      "problemMatcher": []
    },
    {
      "label": "Publish Day",
      "type": "shell",
      "command": "bash tools/publish.sh ${input:day}/directions.md",
      "problemMatcher": []
    },
    {
      "label": "Render Day (local preview)",
      "type": "shell",
      "command": "python3 tools/render.py ${input:day} && open ${input:day}/out",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "day",
      "type": "promptString",
      "description": "Date (YYYY-MM-DD). Leave blank for tomorrow on New Day.",
      "default": ""
    }
  ]
}
